{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/surface-recent-session.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cook-color.py cooking",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/plan-gate/gate.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/auto-allow-prefixed-bash.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/plan-gate/gate.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f ~/.claude-bell ] && afplay /System/Library/Sounds/Glass.aiff || true"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/log-session.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/retitle-window.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/cook-color.py done",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f ~/.claude-bell ] && afplay /System/Library/Sounds/Glass.aiff || true"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/cook-color.py waiting",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cook-color.py restore",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/token-weather",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "typesafe@typesafe-ai": true,
    "impeccable@impeccable": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "outputStyle": "Concise",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(git push --force:*) \u2014 never force-push without an explicit instruction",
      "Bash(vercel --prod*), Bash(vercel promote:*), Bash(vercel alias:*), Bash(vercel rollback:*) \u2014 no prod deploys without being told"
    ]
  }
}
